{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../portfolio-db-I/src",
    "../portfolio-db-I/public"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../portfolio-db-I/src/*"],
      "@config/*": ["../portfolio-db-I/src/config/*"],
      "@components/*": ["../portfolio-db-I/src/components/*"],
      "@layouts/*": ["../portfolio-db-I/src/layouts/*"],
      "@styles/*": ["../portfolio-db-I/src/styles/*"]
    }
  }
}
