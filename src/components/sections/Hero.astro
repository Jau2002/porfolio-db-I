---
import { SITE_META } from '@config/site';

interface Props {
  videoSrc?: string;
  posterSrc?: string;
}

const { videoSrc = SITE_META.videoSrc, posterSrc = 'https://dbportfoliostatics.blob.core.windows.net/containerblobs/poster-placeholder.jpg' } = Astro.props;
---

<section id="presentacion" class="hero">
  <div class="hero__media">
    {
      videoSrc ? (
        <video
          id="hero-video"
          class="hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={posterSrc}
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : (
        <div class="hero__video hero__video--fallback" />
      )
    }
    <div class="hero__overlay"></div>
  </div>

  <img src="/avatar-placeholder.svg" alt="Avatar 8-bit" class="hero__avatar" />

  <div class="wrap hero__content">
    <p class="eyebrow">Presentación</p>
    <h1 class="hero__title">{SITE_META.name}</h1>
    <p class="hero__role">{SITE_META.role}</p>
  </div>

  <a href="#evidencias" class="hero__scroll" aria-label="Ir a evidencias">
    <span></span>
  </a>

  <button 
    id="mute-toggle" 
    class="hero__mute" 
    data-muted="true" 
    aria-label="Activar sonido" 
    aria-pressed="false"
  >
    <img
      src="https://dbportfoliostatics.blob.core.windows.net/containerblobs/icon-muted.svg"
      alt="muted icon"
      class="icon-muted"
    />
    <img
      src="https://dbportfoliostatics.blob.core.windows.net/containerblobs/icon-unmuted.svg"
      alt="unmuted icon"
      class="icon-unmuted"
    />
  </button>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video--fallback {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 20%, #182131 0%, #0a0e17 70%);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 14, 23, 0.55) 0%,
      rgba(10, 14, 23, 0.35) 40%,
      rgba(10, 14, 23, 0.92) 100%
    );
  }

  .hero__avatar {
    position: absolute;
    top: 10%;
    right: clamp(1.5rem, 8vw, 10rem);
    width: clamp(140px, 16vw, 280px);  
    height: auto;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 24px rgba(94, 234, 212, 0.35));
    animation: float 4.5s ease-in-out infinite;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .hero__avatar {
      top: 6%;
      right: 1.25rem;
      width: 120px;
    }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .hero__title {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    line-height: 0.98;
    margin-block: 0.5rem 0.75rem;
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--text-muted);
    margin: 0;
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 38px;
    border: 1.5px solid var(--text-muted);
    border-radius: 12px;
    z-index: 1;
  }

  .hero__scroll span {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    background: var(--accent-cyan);
    border-radius: 50%;
    animation: scrollDot 1.8s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0% { opacity: 1; top: 6px; }
    70% { opacity: 0; top: 20px; }
    100% { opacity: 0; top: 6px; }
  }

  .hero__mute {
    position: absolute;
    bottom: 1.75rem;
    right: clamp(1.25rem, 5vw, 2.5rem);
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(10, 14, 23, 0.6);
    backdrop-filter: blur(8px);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .hero__mute svg {
    pointer-events: none;
  }

  .hero__mute:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  /* Control de visibilidad de iconos según data-muted */
  .hero__mute[data-muted='true'] .icon-muted {
    display: block;
  }

  .hero__mute[data-muted='true'] .icon-unmuted {
    display: none;
  }

  .hero__mute[data-muted='false'] .icon-muted {
    display: none;
  }

  .hero__mute[data-muted='false'] .icon-unmuted {
    display: block;
  }
</style>

<script>
  function setupMuteToggle() {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const btn = document.getElementById('mute-toggle') as HTMLButtonElement | null;

    if (!btn || !video) return;

    // Evitar añadir múltiples listeners si la función se ejecuta de nuevo
    btn.onclick = () => {
      video.muted = !video.muted;

      if (!video.muted) {
        video.play().catch(() => {});
      }

      btn.dataset.muted = String(video.muted);
      btn.setAttribute('aria-pressed', String(!video.muted));
      btn.setAttribute('aria-label', video.muted ? 'Activar sonido' : 'Silenciar');
    };
  }

  // Ejecución directa para carga inicial standard
  setupMuteToggle();

  // Compatibilidad por si usas ClientRouter / View Transitions en Astro
  document.addEventListener('astro:page-load', setupMuteToggle);
</script>
