---
import { EVIDENCIA_CATEGORIAS } from '@config/site';
import ModeladoModulo from '@components/sections/ModeladoModulo.astro';
import NormalizacionModulo from '@components/sections/NormalizacionModulo.astro';
import AlgebraModulo from '@components/sections/AlgebraModulo.astro';
import SqlModulo from '@components/sections/SqlModulo.astro';
import ProyectoModulo from '@components/sections/ProyectoModulo.astro';
---

<section id="evidencias" class="evidencias">
  <div class="wrap">
    <p class="eyebrow">Evidencias</p>
    <h2 class="evidencias__title">Registro del semestre</h2>

    <div class="ev-list">
      {
        EVIDENCIA_CATEGORIAS.map((cat) => (
          <details class="ev-accordion" id={cat.id} open={cat.id === 'modelado'}>
            <summary class="ev-section ev-section--summary">
              <span class="ev-section__num">{cat.numero}</span>
              <h3 class="ev-section__title">{cat.titulo}</h3>
              <span class="ev-section__toggle" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>

            <div class="ev-accordion__body">
              {cat.id === 'modelado' && <ModeladoModulo />}
              {cat.id === 'normalizacion' && <NormalizacionModulo />}
              {cat.id === 'algebra' && <AlgebraModulo />}
              {cat.id === 'sql' && <SqlModulo />}
              {cat.id === 'proyecto' && <ProyectoModulo />}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .evidencias {
    padding-block: clamp(4rem, 10vw, 7rem);
    background: var(--bg-deep);
  }

  .evidencias__title {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    margin-block: 0.5rem 2.5rem;
  }

  .ev-list {
    border-top: 1px solid var(--line);
  }

  .ev-accordion {
    border-bottom: 1px solid var(--line);
  }

  .ev-accordion[open] {
    border-color: var(--accent-cyan);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .ev-section {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 2.5rem);
    padding-block: clamp(1.5rem, 4vw, 2.25rem);
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.25s ease, border-color 0.25s ease;
  }

  .ev-section--summary {
    border-bottom: none;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .ev-section--summary::-webkit-details-marker {
    display: none;
  }

  .ev-section:hover {
    padding-left: 0.75rem;
    border-color: var(--accent-cyan);
  }

  .ev-section__num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent-cyan);
    flex-shrink: 0;
    width: 2.5ch;
  }

  .ev-section__title {
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    color: var(--text-primary);
  }

  .ev-section__toggle {
    margin-left: auto;
    align-self: center;
    color: var(--text-muted);
    display: inline-flex;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .ev-section--summary:hover .ev-section__toggle {
    color: var(--accent-cyan);
  }

  .ev-accordion[open] .ev-section__toggle {
    transform: rotate(180deg);
    color: var(--accent-cyan);
  }
</style>
