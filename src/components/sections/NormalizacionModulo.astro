---
import { EJERCICIOS_NORMALIZACION, type EjercicioNormalizacion } from '@config/site';
import MarkdownBox from '@components/ui/MarkdownBox.astro';

interface Props {
  ejercicios?: EjercicioNormalizacion[];
}

const { ejercicios = EJERCICIOS_NORMALIZACION } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path?: string) => {
  if (!path) return '#';
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
};
---

<div class="norm-lista">
  {
    ejercicios.map((item, idx) => (
      <article class="norm-card" id={`norm-${item.id}`}>
        <header class="norm-card__header">
          <div class="norm-card__title-group">
            <span class="norm-card__index">0{idx + 1}</span>
            <h4 class="norm-card__title">{item.titulo}</h4>
          </div>
          {item.etiqueta && <span class="norm-badge">{item.etiqueta}</span>}
        </header>

        <div class="norm-contexto">
          <MarkdownBox content={item.contextoMd} />
        </div>

        <div class="norm-preview">
          {item.tablasResumen && item.tablasResumen.length > 0 && (
            <div class="norm-steps">
              {item.tablasResumen.map((paso) => (
                <div class="norm-step">
                  <div class="norm-step__head">
                    <span class="norm-step__fn">{paso.formaNormal}</span>
                    <span class="norm-step__desc">{paso.descripcion}</span>
                  </div>
                  <code class="norm-step__schema">{paso.esquema}</code>
                </div>
              ))}
            </div>
          )}

          <a
            href={withBase(item.excelSrc)}
            download={item.excelNombre ?? true}
            class="norm-download"
            aria-label={`Descargar Excel de ${item.titulo}`}
            title="Descargar archivo Excel"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
              <path d="M8 13h2"/>
              <path d="M8 17h2"/>
              <path d="M14 13h2"/>
              <path d="M14 17h2"/>
            </svg>
            <span>Descargar Excel ({item.excelNombre ?? '.xlsx'})</span>
          </a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .norm-lista {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .norm-card {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .norm-card__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .norm-card__title-group {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .norm-card__index {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .norm-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    color: var(--text-primary);
  }

  .norm-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    background: rgba(242, 184, 75, 0.12);
    border: 1px solid rgba(242, 184, 75, 0.3);
    color: var(--accent-warm);
  }

  .norm-contexto {
    padding: 1.1rem 1.35rem;
    background: rgba(10, 14, 23, 0.55);
    border-left: 3px solid var(--accent-warm);
    border-radius: 0 10px 10px 0;
  }

  .norm-preview {
    position: relative;
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-bottom: 4.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .norm-steps {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .norm-step {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .norm-step__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .norm-step__fn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(94, 234, 212, 0.14);
    color: var(--accent-cyan);
  }

  .norm-step__desc {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .norm-step__schema {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--text-primary);
    word-break: break-word;
  }

  .norm-download {
    position: absolute;
    bottom: 1.1rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.1rem;
    border-radius: 9px;
    border: 1px solid rgba(94, 234, 212, 0.5);
    background: rgba(18, 24, 38, 0.92);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .norm-download:hover {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: var(--bg-deep);
  }
</style>
