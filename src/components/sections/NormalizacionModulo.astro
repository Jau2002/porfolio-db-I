---
import { EJERCICIOS_NORMALIZACION, type EjercicioNormalizacion } from '@config/site';
import MarkdownBox from '@components/ui/MarkdownBox.astro';

interface Props {
  ejercicios?: EjercicioNormalizacion[];
}

const { ejercicios = EJERCICIOS_NORMALIZACION } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path?: string) => {
  if (!path) return '#';
  if (path.startsWith('http') || path.startsWith('#')) return path;
  return `${base}${path.startsWith('/') ? path : `/${path}`}`;
};
---

<div class="norm-lista">
  {
    ejercicios.map((item, idx) => (
      <article class="norm-card" id={`norm-${item.id}`}>
        <header class="norm-card__header">
          <div class="norm-card__title-group">
            <span class="norm-card__index">0{idx + 1}</span>
            <h4 class="norm-card__title">{item.titulo}</h4>
          </div>
          {item.etiqueta && <span class="norm-badge">{item.etiqueta}</span>}
        </header>

        {/* 1. Contexto en Markdown */}
        <div class="norm-contexto">
          <MarkdownBox content={item.contextoMd} />
        </div>

        {/* 2. Representación en Tablas Relacionales + Botón de descarga abajo a la derecha */}
        <div class="norm-preview">
          {item.tablas && item.tablas.length > 0 && (
            <div class="norm-tables-group">
              {item.tablas.map((tabla) => (
                <div class="norm-table-block">
                  <div class="norm-table-block__head">
                    <h5 class="norm-table-block__title">{tabla.titulo}</h5>
                    {tabla.subtitulo && (
                      <span class="norm-table-block__sub">{tabla.subtitulo}</span>
                    )}
                  </div>

                  <div class="norm-table-wrap">
                    <table class="norm-table">
                      <thead>
                        <tr>
                          {tabla.columnas.map((col) => (
                            <th>{col}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {tabla.filas.map((fila) => (
                          <tr>
                            {fila.map((celda, colIdx) => (
                              <td class={colIdx === 0 ? 'norm-table__primary-col' : ''}>
                                {celda}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          )}

          <a
            href={withBase(item.archivoSrc)}
            download={item.archivoNombre ?? true}
            class="norm-download"
            aria-label={`Descargar documento de ${item.titulo}`}
            title="Descargar taller de normalización"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Descargar Taller ({item.archivoNombre ?? 'PDF'})</span>
          </a>
        </div>

        {/* 3. Apartado final: Conclusiones / Qué se aprendió */}
        {item.conclusionMd && (
          <footer class="norm-conclusion">
            <div class="norm-conclusion__head">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4"/>
                <path d="m6.8 15-3.5 2"/>
                <path d="m20.7 17-3.5-2"/>
                <path d="M6.8 9 3.3 7"/>
                <path d="m20.7 7-3.5 2"/>
                <circle cx="12" cy="12" r="4"/>
              </svg>
              <span>Conclusión · Qué se aprendió</span>
            </div>
            <MarkdownBox content={item.conclusionMd} />
          </footer>
        )}
      </article>
    ))
  }
</div>

<style>
  .norm-lista {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .norm-card {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .norm-card__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .norm-card__title-group {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .norm-card__index {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .norm-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    color: var(--text-primary);
  }

  .norm-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    background: rgba(94, 234, 212, 0.1);
    border: 1px solid rgba(94, 234, 212, 0.25);
    color: var(--accent-cyan);
  }

  .norm-contexto {
    padding: 1.1rem 1.35rem;
    background: rgba(10, 14, 23, 0.55);
    border-left: 3px solid var(--accent-cyan);
    border-radius: 0 10px 10px 0;
  }

  .norm-preview {
    position: relative;
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-bottom: 4.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .norm-tables-group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .norm-table-block {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .norm-table-block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .norm-table-block__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 0.03em;
  }

  .norm-table-block__sub {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .norm-table-wrap {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--bg-elevated);
  }

  .norm-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .norm-table th {
    background: var(--bg-elevated-2);
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .norm-table td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
    vertical-align: top;
    white-space: pre-line;
  }

  .norm-table td.norm-table__primary-col {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .norm-table tbody tr:last-child td {
    border-bottom: none;
  }

  .norm-table tbody tr:hover td {
    background: rgba(94, 234, 212, 0.03);
  }

  .norm-download {
    position: absolute;
    bottom: 1.15rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.1rem;
    border-radius: 9px;
    border: 1px solid rgba(94, 234, 212, 0.5);
    background: rgba(18, 24, 38, 0.92);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .norm-download:hover {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: var(--bg-deep);
  }

  .norm-conclusion {
    padding: 1rem 1.35rem;
    background: rgba(242, 184, 75, 0.06);
    border: 1px solid rgba(242, 184, 75, 0.22);
    border-left: 3px solid var(--accent-warm);
    border-radius: 0 10px 10px 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .norm-conclusion__head {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-warm);
  }
</style>
